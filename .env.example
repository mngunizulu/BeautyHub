# Copy to .env for local Docker. Use keys from the same Clerk development instance.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
BEAUTYHUB_HTTP_PORT=8080

# Optional local image tag. Production Compose requires an explicit tag and external PostgreSQL.
# DATABASE_URL=postgresql://app_user:password@db.example.invalid/beautyhub?sslmode=verify-full
# BEAUTYHUB_IMAGE_TAG=v0.10.0

# Native API execution also requires DATABASE_URL and PORT.
# Integration tests expect DATABASE_URL to point to a dedicated migrated, seeded test database.
